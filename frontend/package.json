    "@primeng/themes": "^21.0.1",
    "@types/file-saver": "^2.0.7",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide": "^1.23.0",
    "ng2-charts": "^10.0.0",
    "primeflex": "^4.0.0",
