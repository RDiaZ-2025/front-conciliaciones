{
  "name": "frontend",
  "version": "1.7.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve voc",
    "dev": "ng serve voc --port 5173 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build voc",
    "start:voc": "ng serve voc --port 5173 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "start:noc": "ng serve voc --port 5173 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "dev:voc": "ng serve voc --port 5173 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "dev:noc": "ng serve voc --port 5173 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build:voc": "ng build voc",
    "build:noc": "ng build voc",
    "watch": "ng build voc --watch --configuration development",
    "test": "ng test voc",
    "test:voc": "ng test voc",
    "test:noc": "ng test voc"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
